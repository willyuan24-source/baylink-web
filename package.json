{
  "name": "baylink-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run export:guides && npm run export:events && npm run export:planner && npm run generate:share-cards && tsc -b && vite build && tsx --tsconfig tsconfig.app.json scripts/prerender.tsx",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "tsx --tsconfig tsconfig.app.json --test --test-concurrency=4 tests/*.test.ts tests/*.test.tsx tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build && npm run verify:share-cards",
    "export:guides": "tsx --tsconfig tsconfig.app.json scripts/export-guide-catalog.ts",
    "export:planner": "tsx --tsconfig tsconfig.app.json scripts/export-planner-catalog.ts",
    "export:events": "tsx --tsconfig tsconfig.app.json scripts/export-event-catalog.ts",
    "generate:share-cards": "tsx --tsconfig tsconfig.app.json scripts/generate-share-cards.ts",
    "verify:share-cards": "tsx --tsconfig tsconfig.app.json scripts/verify-share-cards.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "6.11.1",
    "opencc-js": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fontkit": "^2.0.4",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  }
}
