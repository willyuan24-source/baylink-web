  "zh-w9-h-today-festival": {"text": "万圣节快乐！今天唐人街的 Waverly 巷有万圣节庆典，下午三点结束～", "line": "w9-h-today-festival", "lane": "h", "language": "zh", "batch": 3, "pick": {"index": 202, "job_id": "dce145bc-2f75-4d79-83af-f0ae522ae480", "speechRate": 1, "duration": 7.24, "passed": true, "asr": "万圣节快乐今天唐人街的Waverly巷有万圣节庆典下午三点结束", "asr_conf": 0.83, "asr_ok": true, "files": {"m4a": {"path": "public/opus-bay/w9/voice/zh-w9-h-today-festival.m4a", "bytes": 61062, "sha256": "463fb9a7e737c25c265b46f5b513a645a49cb136861436158315f0284d579f6e"}, "ogg": {"path": "public/opus-bay/w9/voice/zh-w9-h-today-festival.ogg", "bytes": 43658, "sha256": "5ea0db3bfa2ea8f59230c04512c52b700846964a70306533d5d89c2b25098728"}}}, "takes": [{"index": 202, "job_id": "dce145bc-2f75-4d79-83af-f0ae522ae480", "speechRate": 1, "raw_s": 7.76, "final_s": 7.24, "rate": 3.4, "lufs": -17.85, "tp": -3.59, "peak_dbfs": -1.33, "clipped": 0, "cut_at_end": false, "gap_s": 0.37, "f0": 239, "asr": "万圣节快乐今天唐人街的Waverly巷有万圣节庆典下午三点结束", "asr_conf": 0.83, "asr_ok": true, "gates": {"clip": true, "end": true, "pause": true, "pitch": true, "rate": true}, "pass": true}]},
