 "settings": {"model": "qwen_audio_tts", "voice": "Pixie 0178ef57-ada4-43d9-992b-8d9221045bb4", "format": "wav 48 kHz", "loudness": "two-pass loudnorm I=-18 TP=-1.5 LRA=11 (linear)", "aac": "64k mono", "opus": "48k mono", "source": "scripts/opus-sf/voice/w9/lines.ts (the unrecorded BAYBAY lines of waves 5-9, redo takes of wave-9 muted clips)"},
 "lines": {
  "w5-a-adfb2f33": {"lane": "a", "zh": "这趟太短啦，下次坐远一点再拉闸！", "en": "That ride was too short! Grip on a longer one next time.", "source": "play/sfgames8Lines.ts", "mood": "excited"},
  "w5-a-ddd3b836": {"lane": "a", "zh": "嘿嘿，找个更陡的坡试试？", "en": "Hehe, try a steeper slope?", "source": "play/sled.ts", "mood": "ask"},
  "w5-w2-280f73fb": {"lane": "w2", "zh": "船屋从1893年起就租船给游客。", "en": "The boathouse has rented boats to visitors since 1893.", "source": "world/sf/westLines.ts literal", "mood": "calm"},
  "w5-al-3042cee4": {"lane": "al", "zh": "回城啦。回头再看一眼恶魔岛，前面就是旧金山。", "en": "Heading back to the city. One last look at Alcatraz — San Francisco is just ahead.", "source": "world/sf/alcatrazLines.ts ALCA_LINES.boardBack", "mood": "gentle"},
  "w8w1-pagodas-ahead-w9": {"lane": "w1", "zh": "往上看！路口两座宝塔楼：Sing Fat 和绿顶的 Sing Chong。", "en": "Look up! The two pagoda towers at the corner: Sing Fat, and Sing Chong with the green roofs.", "source": "world/sf/cornersSights.ts W8_W1_LINES[0]", "mood": "calm"},
  "w5-c-df86205a": {"lane": "c", "zh": "想飞的时候，叫上鹈鹕就行～", "en": "Whenever you want to fly, just call the pelican!", "source": "game/pelicanFirst.ts PELICAN_LATER_LINE", "mood": "happy"},
  "w5-r-a13d0aed": {"lane": "r", "zh": "今天城里有活动！旅行本「今天」里写着呢～", "en": "Something’s on in the city today — it’s on the journal’s Today page!", "source": "realsf/todayLine.ts TODAY_EVENT_LINE", "mood": "happy"},
  "w5-r-abd86c7b": {"lane": "r", "zh": "今天的日落时间和三件小事，都在旅行本「今天」里～", "en": "Today’s sunset time and three small things are on the journal’s Today page.", "source": "realsf/todayLine.ts TODAY_SUNSET_LINE", "mood": "happy"},
  "w5-r-7d16e184": {"lane": "r", "zh": "旅行本「今天」里有今日三件小事，慢慢逛～", "en": "Three small things for today wait on the journal’s Today page — no rush.", "source": "realsf/todayLine.ts TODAY_PLAIN_LINE", "mood": "happy"},
  "w5-a-311ad20d": {"lane": "a", "zh": "马路这里过不去，从斑马线过去吧！", "en": "You can’t cross here. Use the zebra crossing!", "source": "play/hideSeek.ts", "mood": "excited"},
  "w9-h-today-festival": {"lane": "h", "zh": "万圣节快乐！今天唐人街的 Waverly 巷有万圣节庆典，下午三点结束～", "en": "Happy Halloween! Chinatown’s Halloween Festival is on Waverly Place today, until three o’clock.", "source": "halloween/worldLines.ts W9_WORLD_LINES[0]", "mood": "happy"},
  "w9-h-today-big-night": {"lane": "h", "zh": "万圣节快乐！今天讨糖街家家都开门，糖果加倍，旅行本「万圣节」页能带你去～", "en": "Happy Halloween! Every treat-street door answers today, treats doubled — the Halloween page takes us there.", "source": "halloween/worldLines.ts W9_WORLD_LINES[1]", "mood": "happy"},
  "w9-h-today-procession": {"lane": "h", "zh": "今晚教会区有亡灵节游行，通常七点从 22 街和布莱恩特街口出发，以官网为准。", "en": "The Día de los Muertos procession usually leaves 22nd & Bryant at seven tonight — check the official site.", "source": "halloween/worldLines.ts W9_WORLD_LINES[2]", "mood": "calm"},
  "w5-n-645daeca": {"lane": "n", "zh": "这段路被挡住了，我们怎么走？", "en": "This way is blocked. How shall we go?", "source": "game/tripRun.ts literal", "mood": "ask"},
  "w5-n-0dede64c": {"lane": "n", "zh": "上次的一日游还没走完，接着走吗？", "en": "We didn’t finish the Grand Tour last time. Shall we go on?", "source": "game/tripRun.ts literal", "mood": "ask"}
 },
