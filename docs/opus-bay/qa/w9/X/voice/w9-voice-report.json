  "en-w5-c-df86205a": {"text": "Whenever you want to fly, just call the pelican!", "line": "w5-c-df86205a", "lane": "c", "language": "en", "batch": 2, "pick": {"index": 101, "job_id": "a97b6234-7ceb-4688-85e7-10648ee5bcfb", "speechRate": 1, "duration": 3.65, "passed": true, "asr": "Whenever you want to fly just call the pelican", "asr_conf": 0.81, "asr_ok": true, "files": {"m4a": {"path": "public/opus-bay/w9/voice/en-w5-c-df86205a.m4a", "bytes": 31167, "sha256": "26e98f8abe493c638c11df9ba02973b0f8c108cd25cd6cc8f41af2f7a7724940"}, "ogg": {"path": "public/opus-bay/w9/voice/en-w5-c-df86205a.ogg", "bytes": 21736, "sha256": "4a88dac327ab38fd08a42b065cdf7b76d57e0625db933f4a78189fc6bed0e322"}}}, "takes": [{"index": 101, "job_id": "a97b6234-7ceb-4688-85e7-10648ee5bcfb", "speechRate": 1, "raw_s": 3.76, "final_s": 3.65, "rate": 2.47, "lufs": -17.71, "tp": -2.71, "peak_dbfs": -1.85, "clipped": 0, "cut_at_end": false, "gap_s": 0.25, "f0": 266, "asr": "Whenever you want to fly just call the pelican", "asr_conf": 0.81, "asr_ok": true, "gates": {"clip": true, "end": true, "pause": true, "pitch": true, "rate": true}, "pass": true}]},
  "zh-w5-r-a13d0aed": {"text": "今天城里有活动！旅行本「今天」里写着呢～", "line": "w5-r-a13d0aed", "lane": "r", "language": "zh", "batch": 2, "pick": {"index": 102, "job_id": "64d6cb57-6413-448e-b6f3-ae7bd49fb1ef", "speechRate": 1, "duration": 4.02, "passed": true, "asr": "今天城里有活动旅行本今天里写着呢", "asr_conf": 0.93, "asr_ok": true, "files": {"m4a": {"path": "public/opus-bay/w9/voice/zh-w5-r-a13d0aed.m4a", "bytes": 33581, "sha256": "2edaa8badbd5f52bbffb35e6723ea40e1df0645c2b6492cc01481c2ec323f577"}, "ogg": {"path": "public/opus-bay/w9/voice/zh-w5-r-a13d0aed.ogg", "bytes": 24022, "sha256": "18f0152d573ad7db4fa85e46eb1eda8286e0b0291b3b0b4737f804d6d9abbb5b"}}}, "takes": [{"index": 102, "job_id": "64d6cb57-6413-448e-b6f3-ae7bd49fb1ef", "speechRate": 1, "raw_s": 4.08, "final_s": 4.02, "rate": 3.98, "lufs": -17.87, "tp": -2.67, "peak_dbfs": -0.17, "clipped": 0, "cut_at_end": false, "gap_s": 0.27, "f0": 247, "asr": "今天城里有活动旅行本今天里写着呢", "asr_conf": 0.93, "asr_ok": true, "gates": {"clip": true, "end": true, "pause": true, "pitch": true, "rate": true}, "pass": true}]},
  "en-w5-r-a13d0aed": {"text": "Something’s on in the city today — it’s on the journal’s Today page!", "line": "w5-r-a13d0aed", "lane": "r", "language": "en", "batch": 2, "pick": {"index": 103, "job_id": "6f0ad49d-2cf2-43b7-b7e9-c7514ca1e7dc", "speechRate": 1, "duration": 4.57, "passed": true, "asr": "Something's on in the city today it's on the journal's Today page", "asr_conf": 0.88, "asr_ok": true, "files": {"m4a": {"path": "public/opus-bay/w9/voice/en-w5-r-a13d0aed.m4a", "bytes": 38640, "sha256": "b794d778d855c7f6d919fd15ff299939f7e1be8b056f8245408985936c256820"}, "ogg": {"path": "public/opus-bay/w9/voice/en-w5-r-a13d0aed.ogg", "bytes": 27090, "sha256": "f155fad3dfb477ed0a2c90c8ccf1d4f75d4f5fca05e92b23b269de5c6b43a05d"}}}, "takes": [{"index": 103, "job_id": "6f0ad49d-2cf2-43b7-b7e9-c7514ca1e7dc", "speechRate": 1, "raw_s": 4.8, "final_s": 4.57, "rate": 2.63, "lufs": -17.37, "tp": -3.84, "peak_dbfs": -2.23, "clipped": 0, "cut_at_end": false, "gap_s": 0.27, "f0": 249, "asr": "Something's on in the city today it's on the journal's Today page", "asr_conf": 0.88, "asr_ok": true, "gates": {"clip": true, "end": true, "pause": true, "pitch": true, "rate": true}, "pass": true}]},
  "zh-w5-r-abd86c7b": {"text": "今天的日落时间和三件小事，都在旅行本「今天」里～", "line": "w5-r-abd86c7b", "lane": "r", "language": "zh", "batch": 2, "pick": {"index": 104, "job_id": "e06eef62-f7ef-4d2b-ab1d-86f81e8e0b32", "speechRate": 1, "duration": 4.65, "passed": true, "asr": "今天的日落时间和三件小事都在旅行本今天里", "asr_conf": 0.99, "asr_ok": true, "files": {"m4a": {"path": "public/opus-bay/w9/voice/zh-w5-r-abd86c7b.m4a", "bytes": 39186, "sha256": "a16ee4fcda188215b1c1091664d73637fae4461f4e50a65d91e62711f215136c"}, "ogg": {"path": "public/opus-bay/w9/voice/zh-w5-r-abd86c7b.ogg", "bytes": 28793, "sha256": "9bcb08497e5f902fe974ff11ef52e363d336b4f60a51e2c7b3b1d96078d5a766"}}}, "takes": [{"index": 104, "job_id": "e06eef62-f7ef-4d2b-ab1d-86f81e8e0b32", "speechRate": 1, "raw_s": 4.72, "final_s": 4.65, "rate": 4.3, "lufs": -18.12, "tp": -4.29, "peak_dbfs": -1.98, "clipped": 0, "cut_at_end": false, "gap_s": 0.01, "f0": 226, "asr": "今天的日落时间和三件小事都在旅行本今天里", "asr_conf": 0.99, "asr_ok": true, "gates": {"clip": true, "end": true, "pause": true, "pitch": true, "rate": true}, "pass": true}]},
  "en-w5-r-abd86c7b": {"text": "Today’s sunset time and three small things are on the journal’s Today page.", "line": "w5-r-abd86c7b", "lane": "r", "language": "en", "batch": 2, "pick": {"index": 105, "job_id": "03bd0ab8-ef41-4b37-9796-6c1a453769d5", "speechRate": 1, "duration": 5.06, "passed": true, "asr": "Today's sunset time and three small things are on the journal's Today page", "asr_conf": 0.95, "asr_ok": true, "files": {"m4a": {"path": "public/opus-bay/w9/voice/en-w5-r-abd86c7b.m4a", "bytes": 43141, "sha256": "ee2c171b4597b672077a80f9884059e83cb341f031b5ddcfc416eff2401c1788"}, "ogg": {"path": "public/opus-bay/w9/voice/en-w5-r-abd86c7b.ogg", "bytes": 30489, "sha256": "d0178886cf0b1369686147a8ee86b16ca73a887ddfbfccdaf0ddecb65edc2263"}}}, "takes": [{"index": 105, "job_id": "03bd0ab8-ef41-4b37-9796-6c1a453769d5", "speechRate": 1, "raw_s": 5.28, "final_s": 5.06, "rate": 2.57, "lufs": -17.32, "tp": -3.31, "peak_dbfs": -3.02, "clipped": 0, "cut_at_end": false, "gap_s": 0.21, "f0": 215, "asr": "Today's sunset time and three small things are on the journal's Today page", "asr_conf": 0.95, "asr_ok": true, "gates": {"clip": true, "end": true, "pause": true, "pitch": true, "rate": true}, "pass": true}]},
  "zh-w5-r-7d16e184": {"text": "旅行本「今天」里有今日三件小事，慢慢逛～", "line": "w5-r-7d16e184", "lane": "r", "language": "zh", "batch": 2, "pick": {"index": 106, "job_id": "2986a400-5861-4a49-b53a-3193d70c5ef0", "speechRate": 1, "duration": 3.99, "passed": true, "asr": "旅行本今天里有今日三件小事慢慢逛", "asr_conf": 0.9, "asr_ok": true, "files": {"m4a": {"path": "public/opus-bay/w9/voice/zh-w5-r-7d16e184.m4a", "bytes": 33503, "sha256": "00bda0b0eed4c38d347d52d05d1bd320d53d1849e0d92c29c80119abcfe0caf4"}, "ogg": {"path": "public/opus-bay/w9/voice/zh-w5-r-7d16e184.ogg", "bytes": 23564, "sha256": "33c80e49193ed6db0561e50c50fc3f54315c927a333a766ff4a48d217722e44c"}}}, "takes": [{"index": 106, "job_id": "2986a400-5861-4a49-b53a-3193d70c5ef0", "speechRate": 1, "raw_s": 4.08, "final_s": 3.99, "rate": 4.01, "lufs": -18.01, "tp": -4.65, "peak_dbfs": -1.43, "clipped": 0, "cut_at_end": false, "gap_s": 0.23, "f0": 253, "asr": "旅行本今天里有今日三件小事慢慢逛", "asr_conf": 0.9, "asr_ok": true, "gates": {"clip": true, "end": true, "pause": true, "pitch": true, "rate": true}, "pass": true}]},
  "en-w5-r-7d16e184": {"text": "Three small things for today wait on the journal’s Today page — no rush.", "line": "w5-r-7d16e184", "lane": "r", "language": "en", "batch": 2, "pick": {"index": 107, "job_id": "89cb415e-0804-4ffa-a4b3-e456dd6a7693", "speechRate": 1, "duration": 5.03, "passed": true, "asr": "Three small things for today wait on the journal's Today page no rush", "asr_conf": 0.89, "asr_ok": true, "files": {"m4a": {"path": "public/opus-bay/w9/voice/en-w5-r-7d16e184.m4a", "bytes": 42826, "sha256": "cfadcf9c48eceb30763d15566bb0657f3407c511448d6bac7973075df72be7cd"}, "ogg": {"path": "public/opus-bay/w9/voice/en-w5-r-7d16e184.ogg", "bytes": 29829, "sha256": "7abf31a265ce108ea4b426c24e42d83f1e563d7267ee9e38b0e7a92e43937ea3"}}}, "takes": [{"index": 107, "job_id": "89cb415e-0804-4ffa-a4b3-e456dd6a7693", "speechRate": 1, "raw_s": 5.28, "final_s": 5.03, "rate": 2.58, "lufs": -17.69, "tp": -3.52, "peak_dbfs": -3.09, "clipped": 0, "cut_at_end": false, "gap_s": 0.37, "f0": 240, "asr": "Three small things for today wait on the journal's Today page no rush", "asr_conf": 0.89, "asr_ok": true, "gates": {"clip": true, "end": true, "pause": true, "pitch": true, "rate": true}, "pass": true}]},
  "zh-w5-a-311ad20d": {"text": "马路这里过不去，从斑马线过去吧！", "line": "w5-a-311ad20d", "lane": "a", "language": "zh", "batch": 3, "pick": {"index": 200, "job_id": "e2b64235-03ed-4974-8e4d-001c3e0d5f62", "speechRate": 1, "duration": 3.18, "passed": true, "asr": "马路这里过不去从斑马线过去吧", "asr_conf": 0.99, "asr_ok": true, "files": {"m4a": {"path": "public/opus-bay/w9/voice/zh-w5-a-311ad20d.m4a", "bytes": 26684, "sha256": "1cbfdc3fa1640db02c8e58fc1b957b1a3a91cb249e394cadfed6306e939fc014"}, "ogg": {"path": "public/opus-bay/w9/voice/zh-w5-a-311ad20d.ogg", "bytes": 19502, "sha256": "ca3d66b8753009438f93c1e9079770e2c353a53e7229d8e2f8e32041b6a63168"}}}, "takes": [{"index": 200, "job_id": "e2b64235-03ed-4974-8e4d-001c3e0d5f62", "speechRate": 1, "raw_s": 3.28, "final_s": 3.18, "rate": 4.4, "lufs": -17.5, "tp": -4.12, "peak_dbfs": -2.38, "clipped": 0, "cut_at_end": false, "gap_s": 0.49, "f0": 250, "asr": "马路这里过不去从斑马线过去吧", "asr_conf": 0.99, "asr_ok": true, "gates": {"clip": true, "end": true, "pause": true, "pitch": true, "rate": true}, "pass": true}]},
