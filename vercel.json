{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/post-page.ts": {
      "includeFiles": "dist/index.html",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://baylink-api.onrender.com wss://baylink-api.onrender.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(brand|guides|default-covers)/(.*\\.(?:png|webp|jpg|jpeg|svg|ico))$",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "^/(?:me|messages(?:/.*)?|reset-password|users/.*)/?$",
      "headers": {
        "X-Robots-Tag": "noindex, follow",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/guides/(bay-area-rental-scam-guide|bay-area-newcomer-first-month-checklist|bay-area-roommate-guide|bay-area-commute-guide|bay-area-used-trading-safety-guide|rental-lease-checklist-before-signing|move-in-move-out-checklist|local-service-safety-guide|peninsula-living-guide|south-bay-living-guide|bay-area-regions-explained|bay-area-where-to-live-first-month|bay-area-first-rental-process|baylink-safety-guide|bay-area-without-car-guide|bay-area-moving-checklist|bay-area-used-furniture-appliance-guide|baylink-posting-guide-for-trust|san-francisco-guide|san-jose-guide|bay-area-airport-arrival-guide|bay-area-part-time-job-safety-guide|bay-area-cleaning-quote-checklist|bay-area-repair-request-guide|bay-area-translation-service-guide|bay-area-library-starter-guide|east-bay-first-weekend-guide|north-bay-car-free-day-guide|bay-area-utilities-address-change-guide|california-driver-license-id-preparation-guide|half-moon-bay-coastal-half-day-guide|reinhardt-redwood-first-walk-guide|presidio-picnic-day-guide|bay-area-farmers-market-shopping-guide|rainy-day-museum-family-guide|bay-area-dog-park-first-outing-guide|bay-area-freebies-deals-2026-09|golden-gate-park-free-car-free-day-guide|palo-alto-baylands-family-walk-guide|sf-golden-gate-bridge-fort-point-guide|sf-fishermans-wharf-pier39-guide|sf-alcatraz-booking-day-guide|sf-chinatown-north-beach-walk-guide|sf-palace-fine-arts-marina-guide|berkeley-campus-botanical-garden-half-day|oakland-lake-merritt-omca-half-day|stanford-cantor-campus-art-walk|filoli-house-garden-day-trip|san-jose-tech-japantown-day-trip|hakone-gardens-saratoga-half-day|muir-woods-reservation-day-trip|sausalito-waterfront-ferry-half-day|bay-area-coastal-cleanup-2026-guide|half-moon-bay-pumpkin-season-2026-guide|bay-area-new-openings-2026-09)/?$",
      "dest": "/guides/$1.html"
    },
    {
      "src": "^/category/(rent|used|moving|cleaning|ride|repair|translation|part-time|other|service)/?$",
      "dest": "/category/$1.html"
    },
    {
      "src": "^/(guides|explore|this-month|tools|recommend|privacy|terms|sms-consent)/?$",
      "dest": "/$1.html"
    },
    {
      "src": "^/posts/([a-zA-Z0-9_-]{1,128})/?$",
      "dest": "/api/post-page?postId=$1"
    },
    {
      "src": "^/404(?:\\.html)?/?$",
      "dest": "/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:me|messages(?:/[^/]+)?|reset-password|users/[^/]+)/?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, follow",
        "Cache-Control": "no-store"
      }
    }
  ]
}
