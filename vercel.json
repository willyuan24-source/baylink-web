{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/post-page.ts": {
      "includeFiles": "dist/index.html",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://baylink-api.onrender.com wss://baylink-api.onrender.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(brand|guides|default-covers)/(.*\\.(?:png|webp|jpg|jpeg|svg|ico))$",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "^/(?:me|messages(?:/.*)?|reset-password|users/.*)/?$",
      "headers": {
        "X-Robots-Tag": "noindex, follow",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/events/(petaluma-pumpkin-patch-2026|redwood-oktoberfest-closing-weekend-2026|cupertino-fall-bike-fest-2026|pacific-coast-fog-fest-2026|portola-2026|presidio-chuseok-festival-2026|sonoma-farm-trails-fall-tour-2026|novato-youth-folk-dance-2026|petaluma-fall-antique-faire-2026|mill-valley-film-festival-2026|santa-rosa-pumpkins-parks-2026|fremont-finding-nemo-outdoor-movie-2026|hardly-strictly-bluegrass-2026|rio-vista-bass-derby-2026|clayton-oktoberfest-2026|oakland-oaktoberfest-2026|redwood-city-portfest-2026|sf-african-arts-festival-2026|sunnyvale-diwali-2026|tiburon-wine-festival-2026|vacaville-learn-your-colors-run-2026|litquake-out-loud-2026|little-italy-san-jose-festival-2026|san-francisco-fleet-week-2026|sf-quinteto-latino-lunchtime-2026|silicon-valley-african-film-festival-2026|marinwood-halloween-harvest-2026|burlingame-mandarin-storytime-2026|cupertino-pooch-plunge-2026|napa-musictime-halloween-2026|novato-nostalgia-days-2026|palo-alto-scare-faire-2026|san-carlos-art-wine-faire-2026|sonoma-harvest-fair-gala-2026|sf-ybg-dance-day-2026|sf-indigenous-peoples-day-2026|oakland-autumn-lights-festival-2026|piedmont-wonka-outdoor-movie-2026|walnut-creek-diablo-improv-2026|berkeley-harvest-festival-2026|campbell-oktoberfest-2026|half-moon-bay-pumpkin-festival-2026|sf-bay-area-science-festival-2026|bay-area-musical-improv-festival-2026|cupertino-hidden-treasures-2026|san-jose-short-film-festival-2026|calistoga-eleanor-alberga-2026|emeryville-art-exhibition-closing-2026|fremont-trick-or-treat-2026|sf-family-connections-halloween-2026|cupertino-monster-mash-2026|foster-city-halloween-festival-2026|menlo-park-halloween-hoopla-2026|petaluma-witches-wizards-water-2026|santa-rosa-halloween-howarth-2026|windsor-trick-or-treat-trail-2026|oakland-omca-dia-muertos-2026|menlo-park-trunk-or-treat-2026|sunnyvale-spooky-storywalk-2026|benicia-farmers-market-final-2026|napa-harvest-after-dark-2026|oakland-omca-friday-finale-2026|palo-alto-addams-family-opening-2026|san-jose-avenida-altares-2026|sf-halloween-hoopla-2026)/?$",
      "dest": "/events/$1.html"
    },
    {
      "src": "^/offers/(target-beauty-sep26|michaels-ghosts-sep26|lowes-kids-lollipop|ikea-family-hot-drink|sephora-birthday|85c-september-cake|homedepot-october-preview|peets-orange-friday-sep25|peets-cold-brew-pass-september|starbucks-cafe-refills|bampfa-free-oct1|sjma-free-oct2|chm-museums-on-us-oct3-4|omca-free-oct4|asian-art-free-oct4|conservatory-free-oct6|botanical-free-oct13|lowes-firefighting-plane-oct17|yogurtland-anniversary-oct20|svma-free-wednesdays-october|japanese-tea-garden-free-hour|sfpl-discover-go|smcl-discover-go|alameda-county-discover-go|santa-clara-library-parks-pass|sonoma-county-museum-family-oct10|sfmoma-family-oct25|cantor-stanford-free|sfpl-radon-detector-loan|berkeley-tool-lending|ikea-emeryville-as-is-wednesdays|poppy-claro-doggie-dinners-fall|peets-coffee-day-sep29|happy-hollow-senior-safari-oct22|muir-woods-fee-free-oct27|chabot-free-telescopes|randall-museum-free|triton-museum-free|anderson-stanford-free|curiodyssey-museums-for-all|exploratorium-for-all-five|lawrence-museums-for-all|sonoma-library-regional-parks|sonoma-library-discover-go|muni-youth-free|clipper-start-half-fares|sfmoma-museums-for-all|cable-car-museum-free|oakland-tool-library|rosie-riveter-richmond-free)/?$",
      "dest": "/offers/$1.html"
    },
    {
      "src": "^/openings/(broken-dreams-oakland|hijau-san-jose-storefront|kaiyo-handroll-union|boulangerie-eria-celebration|mess-hall-presidio-breadwinner|sergeant-ma|marufuku-burlingame-announced|florecita-mission|handroll-hawker|hedley-club|woods-wharf)/?$",
      "dest": "/openings/$1.html"
    },
    {
      "src": "^/guides/(bay-area-rental-scam-guide|bay-area-newcomer-first-month-checklist|bay-area-roommate-guide|bay-area-commute-guide|bay-area-used-trading-safety-guide|rental-lease-checklist-before-signing|move-in-move-out-checklist|local-service-safety-guide|peninsula-living-guide|south-bay-living-guide|bay-area-regions-explained|bay-area-where-to-live-first-month|bay-area-first-rental-process|baylink-safety-guide|bay-area-without-car-guide|bay-area-moving-checklist|bay-area-used-furniture-appliance-guide|baylink-posting-guide-for-trust|san-francisco-guide|san-jose-guide|bay-area-airport-arrival-guide|bay-area-part-time-job-safety-guide|bay-area-cleaning-quote-checklist|bay-area-repair-request-guide|bay-area-translation-service-guide|bay-area-library-starter-guide|east-bay-first-weekend-guide|north-bay-car-free-day-guide|bay-area-utilities-address-change-guide|california-driver-license-id-preparation-guide|half-moon-bay-coastal-half-day-guide|reinhardt-redwood-first-walk-guide|presidio-picnic-day-guide|bay-area-farmers-market-shopping-guide|rainy-day-museum-family-guide|bay-area-dog-park-first-outing-guide|bay-area-freebies-deals-2026-09|golden-gate-park-free-car-free-day-guide|palo-alto-baylands-family-walk-guide|sf-golden-gate-bridge-fort-point-guide|sf-fishermans-wharf-pier39-guide|sf-alcatraz-booking-day-guide|sf-chinatown-north-beach-walk-guide|sf-palace-fine-arts-marina-guide|berkeley-campus-botanical-garden-half-day|oakland-lake-merritt-omca-half-day|stanford-cantor-campus-art-walk|filoli-house-garden-day-trip|san-jose-tech-japantown-day-trip|hakone-gardens-saratoga-half-day|muir-woods-reservation-day-trip|sausalito-waterfront-ferry-half-day|half-moon-bay-pumpkin-season-2026-guide|bay-area-new-openings-2026-09|bay-area-october-weekend-planner-2026|half-moon-bay-october-pumpkin-coast-guide-2026|san-jose-october-family-history-farm-guide-2026|east-bay-tilden-october-family-guide-2026|north-bay-china-camp-october-culture-guide-2026|bay-area-october-library-museum-pass-guide-2026|bay-area-freebies-deals-2026-10|bay-area-october-muni-clipper-payment-update-2026|sf-sunset-dunes-october-coastal-walk-2026|san-mateo-japanese-garden-october-guide-2026|alviso-marina-october-birdwatching-guide-2026|fremont-ardenwood-october-farm-guide-2026|richmond-rosie-free-history-october-guide-2026|martinez-shoreline-october-short-walk-guide-2026|pleasanton-saturday-market-museum-guide-october-2026|marin-sunday-market-october-local-guide-2026|sonoma-plaza-history-october-day-guide-2026|napa-bothe-october-redwood-picnic-guide-2026)/?$",
      "dest": "/guides/$1.html"
    },
    {
      "src": "^/category/(rent|used|moving|cleaning|ride|repair|translation|part-time|other|service)/?$",
      "dest": "/category/$1.html"
    },
    {
      "src": "^/(guides|explore|this-month|tools|recommend|about|privacy|terms|sms-consent)/?$",
      "dest": "/$1.html"
    },
    {
      "src": "^/posts/([a-zA-Z0-9_-]{1,128})/?$",
      "dest": "/api/post-page?postId=$1"
    },
    {
      "src": "^/404(?:\\.html)?/?$",
      "dest": "/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:me|messages(?:/[^/]+)?|reset-password|users/[^/]+)/?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, follow",
        "Cache-Control": "no-store"
      }
    }
  ]
}
